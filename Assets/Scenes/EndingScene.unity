  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e3c8d4fcc5a0a8f43b037b148d29e9d5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  endingText: {fileID: 154067429}
  endingImage: {fileID: 767244865}
  nextIndicator: {fileID: 54290358}
  elements:
  - dialogue: "\uC800\uAE30...."
    image: {fileID: 21300000, guid: 4225250bcfcfcfd4f97ad3d7532c9ce3, type: 3}
  - dialogue: "\uC81C\uBC1C.. \uC7A0\uC2DC\uB9CC.... \uB0B4 \uB9D0\uC880....."
    image: {fileID: 21300000, guid: 25ab263e30b77e44ba331b4f8a62ed9c, type: 3}
  - dialogue: "\uB098\uC57C \uB098. \uB808\uB098\uB77C\uACE0."
    image: {fileID: 0}
  - dialogue: "\uB110 \uB2E4\uCE58\uAC8C \uD558\uB824\uB358 \uAC8C \uC544\uB2C8\uC57C.."
    image: {fileID: 0}
  - dialogue: "\uB09C \uADF8\uB0E5 \uB124\uAC00.. \uB0B4 \uBAA8\uC2B5\uC744 \uBCF4\uACE0
      \uADF8\uB807\uAC8C \uB180\uB784 \uC904\uC740 \uBAB0\uB790\uC5B4."
    image: {fileID: 0}
  - dialogue: "\uB124\uAC8C... \uAF2D \uBD80\uD0C1\uD558\uACE0 \uC2F6\uC5C8\uB358
      \uAC8C \uC788\uC5C8\uC5B4..."
    image: {fileID: 0}
  - dialogue: "\uC5B4\uCA4C\uB2E4 \uB124\uAC00 \uC774 \uD3D0\uAD50\uC5D0 \uB4E4\uC5B4\uC628
      \uC9C0\uB294 \uC798 \uBAA8\uB974\uACA0\uC9C0\uB9CC.."
    image: {fileID: 0}
  - dialogue: "\uB0B4 \uC5B5\uC6B8\uD55C \uC8FD\uC74C\uC744.. \uBAA8\uB450\uAC00
      \uBB3B\uC5B4\uAC14\uB358 \uC0AC\uC2E4\uC744.."
    image: {fileID: 0}
  - dialogue: "\uC138\uC0C1 \uBAA8\uB450\uAC00 \uC54C\uAC8C \uD574\uC918. \uBD80\uD0C1\uC774\uC57C."
    image: {fileID: 0}
  - dialogue: "\uADF8\uB9AC\uACE0 \uB0A0 \uC774\uB807\uAC8C \uB9CC\uB4E0 \uADF8 \uB140\uC11D..."
    image: {fileID: 21300000, guid: b85d251367a5bb843a095f46513dce9a, type: 3}
  - dialogue: "\uADF8 \uB140\uC11D\uC774 \uBC8C\uC744 \uBC1B\uC744 \uC218 \uC788\uAC8C
      \uD574\uC918."
    image: {fileID: 21300000, guid: b85d251367a5bb843a095f46513dce9a, type: 3}
  - dialogue: "\uB0B4 \uB9C8\uC9C0\uB9C9 \uBD80\uD0C1\uC774\uC57C. "
    image: {fileID: 0}
  - dialogue: ...
    image: {fileID: 0}
  - dialogue: ...
    image: {fileID: 21300000, guid: 7d680ad59f3a20c4391a92f516581a5d, type: 3}
  - dialogue: ...
    image: {fileID: 21300000, guid: 40b14a78abba00e4ba7c7d99b61acc6a, type: 3}
  - dialogue: ...
    image: {fileID: 0}
  - dialogue: ...
    image: {fileID: 0}
  startDelay: 3
  typingSpeed: 0.05
  clearUI: {fileID: 1284736983}
